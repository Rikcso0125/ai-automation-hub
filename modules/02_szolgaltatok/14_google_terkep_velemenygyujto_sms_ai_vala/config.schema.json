{
  "title": "Google Térkép Véleménygyűjtő & AI Válaszíró Konfiguráció",
  "type": "object",
  "properties": {
    "primary_channel": {
      "type": "string",
      "title": "Elsődleges Megkeresési Csatorna",
      "enum": [
        "whatsapp_first_with_sms_fallback",
        "sms_only",
        "whatsapp_only",
        "email"
      ],
      "default": "whatsapp_first_with_sms_fallback"
    },
    "send_delay_mode": {
      "type": "string",
      "title": "Kiküldési Időzítés",
      "enum": [
        "immediate",
        "1_hour_after_job",
        "next_morning_10am"
      ],
      "default": "1_hour_after_job"
    },
    "google_review_url": {
      "type": "string",
      "title": "Közvetlen Google Értékelési Link",
      "default": "https://g.page/r/profiklima-budapest/review"
    },
    "gatekeeper_enabled": {
      "type": "boolean",
      "title": "Reputációvédő Gatekeeper Engedélyezése (1-3 csillag szűrése)",
      "default": true
    },
    "approval_mode": {
      "type": "string",
      "title": "AI Válasz Publikálási Mód",
      "enum": [
        "positive_auto_negative_review",
        "all_review_required",
        "full_auto"
      ],
      "default": "positive_auto_negative_review",
      "description": "A opció: 4-5 csillagos pozitív vélemények azonnal kimennak, 1-3 csillag vezetői jóváhagyáshoz kötött."
    },
    "local_seo_keywords": {
      "type": "array",
      "title": "Helyi SEO Kulcsszavak a Válaszokba",
      "items": {
        "type": "string"
      },
      "default": [
        "klímaszerelés",
        "Budapest",
        "karbantartás",
        "gázkazán csere",
        "hőszivattyú"
      ]
    },
    "company_name": {
      "type": "string",
      "title": "Cégnév",
      "default": "ProfiKlíma Kft."
    }
  }
}